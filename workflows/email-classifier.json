    {
      "id": "c837b909-adf3-495f-8cc0-b9ae770b84de",
      "name": "Classify Email",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        180,
        300
      ],
      "parameters": {
        "promptType": "define",
        "text": "=You are an email triage classifier for the inbox of a product manager in London who is actively job-hunting. Their inbox mixes job-search email (applications, recruiters, automated job-listing digests from LinkedIn/Indeed/etc) with personal and other email.\n\nClassify the email below into EXACTLY ONE category:\n\n- ACTION_NEEDED: Personal or other email that is NOT job-search-related and requires the user to do something (reply, pay, schedule, decide, etc).\n- JOB_CONFIRMATION: An automated \"we received your application\" acknowledgement from a company or applicant tracking system.\n- JOB_REJECTION: An explicit rejection of a job application (e.g. \"we've decided to move forward with other candidates\").\n- RECRUITER_REPLY: A human recruiter or hiring manager personally writing to the user - replying, reaching out, or scheduling - not an automated ATS message.\n- JOB_ALERT: An automated job-listing digest or alert, e.g. from LinkedIn, Indeed, or similar job boards.\n- FYI: Informational email that needs no action and isn't spam (newsletters the user actually reads, receipts, confirmations unrelated to jobs, etc).\n- IGNORE: Spam, marketing, or low-value automated notifications.\n\nEmail to classify:\nFrom: {{ $json.from?.emailAddress?.name || $json.from?.name || '' }} <{{ $json.from?.emailAddress?.address || $json.from?.address || '' }}>\nSubject: {{ $json.subject }}\nBody:\n{{ ((($json.body && $json.body.content) || $json.bodyPreview || '') + '').replace(/<[^>]+>/g, ' ').slice(0, 1500) }}\n\nRespond with:\n- category: exactly one of ACTION_NEEDED, JOB_CONFIRMATION, JOB_REJECTION, RECRUITER_REPLY, JOB_ALERT, FYI, IGNORE\n- confidence: integer 0-100, how sure you are of the category\n- summary: one tight sentence summarizing the email\n- suggested_task: a concrete next action for the user, ONLY if one clearly exists, otherwise null\n- company: the employer name if category is JOB_CONFIRMATION, JOB_REJECTION, or RECRUITER_REPLY and it's identifiable, otherwise null",
        "hasOutputParser": true
      }
    },
    {
      "id": "7559d10b-0395-4952-b4ea-ded08bffa54d",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [
        80,
        540
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "id",
          "value": "claude-haiku-4-5-20251001"
        },
        "options": {
          "temperature": 0
        }
      }
    },
    {
      "id": "40d1b0c5-3faf-4196-b709-bd10dd934a88",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        320,
        540
      ],
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"ACTION_NEEDED\",\n        \"JOB_CONFIRMATION\",\n        \"JOB_REJECTION\",\n        \"RECRUITER_REPLY\",\n        \"JOB_ALERT\",\n        \"FYI\",\n        \"IGNORE\"\n      ],\n      \"description\": \"The single best-fit category for this email\"\n    },\n    \"confidence\": {\n      \"type\": \"integer\",\n      \"minimum\": 0,\n      \"maximum\": 100,\n      \"description\": \"How confident the model is in the chosen category, 0-100\"\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"One tight sentence summarizing the email\"\n    },\n    \"suggested_task\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"A concrete next action for the user, or null if none exists\"\n    },\n    \"company\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"description\": \"Employer name for JOB_CONFIRMATION, JOB_REJECTION, or RECRUITER_REPLY when identifiable, else null\"\n    }\n  },\n  \"required\": [\n    \"category\",\n    \"confidence\",\n    \"summary\",\n    \"suggested_task\",\n    \"company\"\n  ]\n}"
      }
    },
    {
      "id": "4db0628e-214b-4d64-af6a-4f0de8b2d4c5",
      "name": "Log to Email Metrics",
      "type": "n8n-nodes-base.notion",
      "typeVersion": 2.2,
      "position": [
        480,
        300
