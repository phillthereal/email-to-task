        "operation": "create",
        "databaseId": {
          "__rl": true,
          "mode": "id",
          "value": "YOUR_EMAIL_METRICS_LOG_DATABASE_ID"
        },
        "title": "={{ $json.output.summary }}",
        "propertiesUi": {
          "propertyValues": [
            {
              "key": "Timestamp|date",
              "date": "={{ $now.toISO() }}"
            },
            {
              "key": "Category|select",
              "selectValue": "={{ $json.output.category }}"
            },
            {
              "key": "Confidence|number",
              "numberValue": "={{ $json.output.confidence }}"
            },
            {
              "key": "Suggested Task|rich_text",
              "textContent": "={{ $json.output.suggested_task || '' }}"
            },
            {
              "key": "Corrected|checkbox",
              "checkboxValue": false
            },
            {
              "key": "Auto-filed|checkbox",
              "checkboxValue": "={{ $json.output.confidence >= 80 }}"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b1a0bb87-81f3-450c-bebb-6ac55255b474",
      "name": "Confidence >= 80?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        740,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "version": 2,
            "leftValue": "",
            "caseSensitive": true,
            "typeValidation": "strict"
          },
          "combinator": "and",
          "conditions": [
            {
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "leftValue": "={{ $('Classify Email').item.json.output.confidence }}",
              "rightValue": 80
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5da100fd-30ec-47b2-9c01-9bb0de2a81d0",
      "name": "Route by Category",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1000,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "ACTION_NEEDED",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $('Classify Email').item.json.output.category }}",
                    "rightValue": "ACTION_NEEDED"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "RECRUITER_REPLY",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $('Classify Email').item.json.output.category }}",
                    "rightValue": "RECRUITER_REPLY"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "JOB_CONFIRMATION",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $('Classify Email').item.json.output.category }}",
                    "rightValue": "JOB_CONFIRMATION"
                  }
                ]
              },
              "renameOutput": true
            },
            {
              "outputKey": "JOB_REJECTION",
              "conditions": {
                "options": {
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $('Classify Email').item.json.output.category }}",
                    "rightValue": "JOB_REJECTION"
                  }
                ]
              },
              "renameOutput": true
            }
          ]
        },
        "options": {}
      }
    },
