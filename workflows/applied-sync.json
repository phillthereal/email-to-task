    {
      "name": "Success Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        320,
        140
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ \"<!doctype html><html><head><meta charset=\\\"utf-8\\\"><meta name=\\\"viewport\\\" content=\\\"width=device-width,initial-scale=1\\\"><title>Marked as applied</title></head><body style=\\\"margin:0;padding:48px 20px;background:#f9fafb;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;\\\"><div style=\\\"max-width:420px;margin:0 auto;background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;padding:28px;text-align:center;\\\"><div style=\\\"font-size:34px;line-height:1;\\\">&#9989;</div><div style=\\\"font-size:18px;font-weight:700;color:#15803d;margin-top:12px;\\\">Marked as applied</div><div style=\\\"font-size:14px;color:#4b5563;margin-top:10px;line-height:1.5;\\\">__JOB__moves to <b>Applied</b> in Job Opportunities and drops out of next week&rsquo;s matches. The tracker row is created by the next daily sync (12:00). You can close this tab.</div></div></body></html>\".replace('__JOB__', $json.name ? '<b>' + $json.name + '</b> &mdash; it ' : 'It ') }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              }
            ]
          }
