    {
      "name": "Find Unsynced Applied Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        700
      ],
      "parameters": {
        "jsCode": "const jobOpps = $('Get Job Opportunities').all();\nconst trackerRows = $('Get Application Tracker Rows').all();\n\nfunction normUrl(url) {\n  if (!url) return '';\n  let u = String(url).trim().toLowerCase();\n  u = u.split('?')[0].split('#')[0];\n  u = u.replace(/\\/+$/, '');\n  return u;\n}\n\nfunction normText(s) {\n  return String(s || '').trim().toLowerCase().replace(/\\s+/g, ' ');\n}\n\nfunction selectName(v) {\n  if (v == null) return '';\n  if (typeof v === 'object') return v.name || v.value || '';\n  return String(v);\n}\n\nconst trackerUrls = new Set();\nconst trackerCompanyRole = new Set();\nfor (const row of trackerRows) {\n  const j = row.json;\n  const link = normUrl(j.property_job_link);\n  if (link) trackerUrls.add(link);\n  const company = normText(j.name || j.property_company);\n  const role = normText(j.property_role);\n  trackerCompanyRole.add(`${company}|${role}`);\n}\n\nconst results = [];\nfor (const job of jobOpps) {\n  const j = job.json;\n  const status = selectName(j.property_status);\n  if (status !== 'Applied') continue;\n\n  const company = normText(j.property_company);\n  if (!company) continue; // skip blank company - would create blank tracker title\n\n  const role = normText(j.name || j.property_job);\n  const url = normUrl(j.property_url);\n\n  const urlMatch = url && trackerUrls.has(url);\n  const companyRoleMatch = trackerCompanyRole.has(`${company}|${role}`);\n  if (urlMatch || companyRoleMatch) continue;\n\n  results.push({\n    json: {\n      company: j.property_company,\n      role: j.name || j.property_job || '',\n      jobLink: j.property_url || '',\n      notes: 'Auto-synced from Job Opportunities (marked Applied).'\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "3f7108df-9a6a-4f76-a455-d5365fe6f500"
    },
