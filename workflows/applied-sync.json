            },
            {
              "key": "Job Link|url",
              "urlValue": "={{ $json.jobLink }}"
            },
            {
              "key": "Notes|rich_text",
              "textContent": "={{ $json.notes }}"
            }
          ]
        },
        "options": {}
      },
      "id": "3e79f2ec-85a4-4232-bb39-180ca5ecac6e"
    }
