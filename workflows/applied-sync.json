        80,
        380
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>No job id</title></head><body style=\"margin:0;padding:48px 20px;background:#f9fafb;font-family:-apple-system,Segoe UI,Helvetica,Arial,sans-serif;\"><div style=\"max-width:420px;margin:0 auto;background:#ffffff;border:1px solid #e5e7eb;border-radius:10px;padding:28px;text-align:center;\"><div style=\"font-size:34px;line-height:1;\">&#9888;&#65039;</div><div style=\"font-size:18px;font-weight:700;color:#b45309;margin-top:12px;\">No job id supplied</div><div style=\"font-size:14px;color:#4b5563;margin-top:10px;line-height:1.5;\">That link was missing its job id, so nothing was changed. Open the job in Notion and set Status to Applied by hand.</div></div></body></html>",
        "options": {
